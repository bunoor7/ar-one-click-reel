{
  "_readme": "Copy this file to the path printed by `python bridge.py doctor` and edit it. It holds NO keys. Model ids change often: run `python bridge.py models --live PROVIDER` and copy a real id into 'models'.",
  "providers": {
    "gemini": {
      "type": "gemini",
      "key": { "keyring": "gemini", "env": "GEMINI_API_KEY" },
      "models": { "flash": "REPLACE_WITH_MODEL_ID", "image": "REPLACE_WITH_IMAGE_MODEL_ID" }
    },
    "openai": {
      "type": "openai",
      "base_url": "https://api.openai.com/v1",
      "max_tokens_param": "max_completion_tokens",
      "key": { "keyring": "openai", "env": "OPENAI_API_KEY" },
      "models": { "main": "REPLACE_WITH_MODEL_ID", "image": "REPLACE_WITH_IMAGE_MODEL_ID" }
    },
    "openrouter": {
      "type": "openai",
      "base_url": "https://openrouter.ai/api/v1",
      "key": { "keyring": "openrouter", "env": "OPENROUTER_API_KEY" },
      "models": { "free": "REPLACE_WITH_MODEL_ID" }
    },
    "local": {
      "type": "openai",
      "base_url": "http://localhost:11434/v1",
      "key": { "keyring": "local", "env": "LOCAL_API_KEY", "proxy": true },
      "models": { "local": "REPLACE_WITH_MODEL_ID" }
    }
  },
  "allowed_dirs": [],
  "limits": {
    "max_calls_per_day": 100,
    "max_output_tokens": 2000
  }
}
